# copy to .env and fill in
ANTHROPIC_API_KEY=sk-ant-...

# Gmail over IMAP (Google app password, not the account password)
APPTRACK_EMAIL=you@gmail.com
APPTRACK_APP_PASSWORD=xxxx xxxx xxxx xxxx

# optional overrides (defaults shown)
APPTRACK_MODEL=claude-haiku-4-5-20251001
APPTRACK_APPLICANT_NAME=James Hose
APPTRACK_LOOKBACK_DAYS=30
APPTRACK_AUTO_CONF=0.85

# set to 0 to run inbox -> board only (no Google Calendar/Tasks, no OAuth)
APPTRACK_CALENDAR=1

# daily accountability hour placement
APPTRACK_HOUR_START=9
APPTRACK_HOUR_END=21
APPTRACK_SKIP_WEEKENDS=0
APPTRACK_CALENDAR_ID=primary
