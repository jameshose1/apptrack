<?xml version="1.0" encoding="UTF-8"?>
<!-- Install:
       cp com.apptrack.scan.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.apptrack.scan.plist
     Runs the scan at 9am, 1pm, 6pm daily (when the Mac is awake). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.apptrack.scan</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/jameshose1/dev/apptrack/scanner/.venv/bin/python</string>
    <string>/Users/jameshose1/dev/apptrack/scanner/scan.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/jameshose1/dev/apptrack/scanner</string>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>/Users/jameshose1/dev/apptrack/data/scan.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jameshose1/dev/apptrack/data/scan.err.log</string>
</dict>
</plist>
